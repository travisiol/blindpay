# Public site URL used for metadata, sitemap and robots. Payment links use
# the browser's own origin at runtime, not this value.
NEXT_PUBLIC_SITE_URL=https://blindpay.example

# --- Vault --------------------------------------------------------------
# The pooled vault contract. Leave unset until yours is deployed: invoices
# can still be created (keys derive in the browser), but paying and claiming
# stay disabled with the reason shown, and balances read as zero.
NEXT_PUBLIC_BLINDPAY_VAULT_ADDRESS=
# EIP-712 domain name the vault was deployed with. Claim signatures verify
# against it on chain, so it must match the contract byte for byte.
NEXT_PUBLIC_BLINDPAY_EIP712_NAME=BlindPay
# Fee pool address, listed in the docs. Renders as "not set" while unset.
NEXT_PUBLIC_BLINDPAY_FEE_POOL=
# Assets new invoices may be issued in. Everything else in the registry
# only pays links that already exist.
NEXT_PUBLIC_BLINDPAY_CREATE_TOKENS=NVDA,USDG

# --- Nav ----------------------------------------------------------------
# Token contract address shown in the "CA" chip. Hidden while unset.
NEXT_PUBLIC_BLINDPAY_CA=
# X profile URL. The button is hidden while unset.
NEXT_PUBLIC_BLINDPAY_X=

# --- Chain --------------------------------------------------------------
# Defaults are Robinhood Chain mainnet (id 4663). Override for a private RPC.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com
